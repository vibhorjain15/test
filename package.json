  "scripts": {
    "ng": "ng",
    "start": "node --max_old_space_size=8192 ./node_modules/@angular/cli/bin/ng serve",
    "mono-serve": "set NODE_OPTIONS=--max-old-space-size=8192 && npx nx serve --configuration=development --parallel",
    "mono-build": "set NODE_OPTIONS=--max-old-space-size=8192 && npx nx build --configuration=production --parallel",
    "mono-build-many": "npx nx run-many --target=build --projects=DV_MVC_REST --configuration=production --parallel --max-parallel=3",
    "mono-build-affected": "set NODE_OPTIONS=--max-old-space-size=8192 && nx affected -t=build --configuration=production --parallel",
    "build": "nx build",
    "build:prod": "node --max_old_space_size=8192 ./node_modules/@angular/cli/bin/ng build  --configuration production",
    "watch": "nx build --watch --configuration development",
    "test": "npx playwright test --ui",
    "test:report": "npx playwright show-report",
    "postinstall": "patch-package",
    "prepare": "patch-package"
  },
