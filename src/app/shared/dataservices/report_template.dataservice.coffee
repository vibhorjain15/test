angular.module('diligenceVault').factory 'ReportTemplateDataservice', (Restangular, RbComponentFactory,RestangularHeaderService, Upload, baseUrl)->
  new class ReportTemplateDataservice

    selected_report_template = {}

    setReportTemplate: (template) ->
      selected_report_template = template

    getSelectedReportTemplate: ->
      selected_report_template

    getTemplates: (params) ->
      Restangular.all('report_templates').getList(params)

    getTemplate: (params) ->
      Restangular.one('report_templates' , params.id).get({is_new_report: params.is_new_report})

    getHtmlReport: (id) =>
      Restangular.one('reports/html', id).get()

    downloadReportTemplate: (id) ->
      Restangular.one('reports/download', id).get()

    updateTemplate: (id, params) ->
      Restangular.one('report_templates', id).customPUT(params)

    create: (params) ->
      Restangular.all('report_templates').post(params)

    deleteReportTemplate: (params) ->
      Restangular.one('report_templates', params.id).remove({is_new_report: params.is_new_report})

    newTemplate: (report_name="Untitled Template")->
      components = [
        RbComponentFactory.createNewComponent('text')
      ]

      {
        definition: RbComponentFactory.formatComponents(components)
        name: report_name
      }

    createReport: (params,pageUrl) ->
      RestangularHeaderService.RestangularWithHeader(pageUrl).all('reports').post(params)

    getReports: ->
      Restangular.all('reports').getList()

    getReport: (id) ->
      Restangular.one('reports', id).get()

    deleteRealtimeReport: (id) ->
      Restangular.one('reports', id).remove()

    deleteNewReport: (id) ->
      Restangular.one('reports', id).remove({is_new_report: true})

    updateReport: (id, params) ->
      Restangular.one('report_templates', id).customPUT(params)

    addReportDocument: (files, fields) ->
      params =
        method: 'POST'
        url: baseUrl + "/reports/new/report_template_mapping"
        file: files

      if fields?
        params.fields = fields

      Upload.upload params

